# ── Required ────────────────────────────────────────────────────────────
# Neon Postgres connection string (Vercel > Storage > Neon sets this for you)
DATABASE_URL=postgres://user:password@host/dbname?sslmode=require
# Long random string used to sign login cookies:  openssl rand -base64 32
JWT_SECRET=

# ── Optional ────────────────────────────────────────────────────────────
# Comma-separated emails that can open /admin (review reports, edit questions)
ADMIN_EMAILS=you@example.com
# Public site URL used in emailed links (defaults to the request's origin)
APP_URL=https://aws-quiz-app-mu.vercel.app
# Transactional email via Resend (https://resend.com). Without these, password-reset
# and verification links are written to the function logs instead of being emailed.
RESEND_API_KEY=
EMAIL_FROM="AWS Quiz <no-reply@yourdomain.com>"
